
{
  // Worker 基本設定
  "name": "ragic-breezysign",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,

  // 保留客戶在 Cloudflare 網頁設定的環境變數
  "keep_vars": true,

  // 啟用執行紀錄
  "observability": {
    "enabled": true
  },

  // API 頻率限制
  "ratelimits": [
    {
      "name": "RL_ACTION",
      "namespace_id": "3301",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_CALLBACK",
      "namespace_id": "3302",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_GLOBAL",
      "namespace_id": "3303",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
